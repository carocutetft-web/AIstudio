# Server env example for payment helper

# JSON mapping of itemId -> MercadoPago payment link template. Use {ORDER_ID} as placeholder where possible.
# Example: {"gold_pack":"https://mp.example/checkout?pref_id=abc&external_reference={ORDER_ID}"}
MP_LINKS_JSON={}

# JSON mapping of itemId -> PayPal payment link template
PP_LINKS_JSON={}

# Optional simple webhook secret header that the server expects
MP_WEBHOOK_SECRET=
PP_WEBHOOK_SECRET=

# Admin token to inspect orders via GET /api/orders (optional)
ADMIN_TOKEN=

# Server port
PORT=4000
